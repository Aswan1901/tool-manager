# =============================================
# DATABASE CONFIGURATION - INTERNAL TOOLS TEST
# =============================================

# PostgreSQL Configuration
POSTGRES_DATABASE=internal_tools
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev123
POSTGRES_PORT=5432

# Admin Tools (optional - use with --profile admin-tools)
PGADMIN_PORT=8081
PGADMIN_EMAIL=admin@test.local
PGADMIN_PASSWORD=admin123

# =============================================
# APPLICATION CONNECTION STRINGS (for candidates)
# =============================================
# PostgreSQL Connection Examples
POSTGRES_CONNECTION_STRING="postgresql://dev:dev123@localhost:5432/internal_tools"
POSTGRES_DSN="pgsql:host=localhost;port=5432;dbname=internal_tools"

# =============================================
# DEVELOPMENT NOTES
# =============================================
# Start MySQL only: docker-compose up mysql
# Start PostgreSQL only: docker-compose up postgres
# With admin tools: docker-compose --profile admin-tools up mysql phpmyadmin
# Reset everything: docker-compose down -v && docker-compose up
